<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My ecommerce</title>
</head>
<style>
  .products{
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 50px
  }

  .product{
    border: 1px solid black;
    padding: 16px;
    border-radius: 6px;
  }

  .product-image{
    width: 100%;
    height: 300px;
    background-color: rgb(141, 141, 141);
  }
  .inactive{
    opacity: 0.3;
  }
</style>

<body>
  <nav>
    <a href="/">Home</a>
    <a href="/dashboard">Dashboard</a>
  </nav>
    {{{body}}}
  <footer></footer>
</body>
</html>